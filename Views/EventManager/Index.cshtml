@model List<Assignment1EventHandler.Models.Event>

@{
    ViewData["Title"] = "Event Manager";
}

<h1>Event Manager</h1>

<p>@ViewData["Description"]</p>

<hr />

@foreach (var eventItem in Model)
{
    <div class="card mb-3">
        <div class="card-body">

            <h2>@eventItem.Title</h2>

            <p>
                <strong>Date:</strong>
                @eventItem.Date.ToString("MMMM dd, yyyy h:mm tt")
            </p>

            <p>
                <strong>Location:</strong>
                @eventItem.Location
            </p>

            <p>
                <strong>Attendees:</strong>
                @eventItem.Attendees.Count
            </p>

            <a asp-controller="EventManager"
               asp-action="ManageAttendees"
               asp-route-id="@eventItem.Id"
               class="btn btn-primary">
                Manage Attendees
            </a>

        </div>
    </div>
}