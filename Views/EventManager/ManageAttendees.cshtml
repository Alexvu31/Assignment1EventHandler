@model Assignment1EventHandler.Models.Event

@{
    ViewData["Title"] = "Manage Attendees";
}

<h1>Manage Attendees</h1>

<h2>@Model.Title</h2>

<p>
    <strong>Date:</strong>
    @Model.Date.ToString("MMMM dd, yyyy h:mm tt")
</p>

<p>
    <strong>Location:</strong>
    @Model.Location
</p>

<hr />

<h3>Sign Up</h3>

<form asp-controller="EventManager"
      asp-action="ManageAttendees"
      method="post">

    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label for="Name" class="form-label">
            Name
        </label>

        <input type="text"
               id="Name"
               name="Name"
               class="form-control"
               required />
    </div>

    <div class="mb-3">
        <label for="Email" class="form-label">
            Email
        </label>

        <input type="email"
               id="Email"
               name="Email"
               class="form-control"
               required />
    </div>

    <button type="submit" class="btn btn-success">
        Sign Up
    </button>

</form>

<hr />

<h3>Attendees</h3>

@if (Model.Attendees.Count == 0)
{
    <p>No attendees have signed up yet.</p>
}
else
{
    <table class="table table-striped">

        <thead>
            <tr>
                <th>Name</th>
                <th>Email</th>
            </tr>
        </thead>

        <tbody>

            @foreach (var attendee in Model.Attendees)
            {
                <tr>
                    <td>@attendee.Name</td>
                    <td>@attendee.Email</td>
                </tr>
            }

        </tbody>

    </table>
}

<br />

<a asp-controller="EventManager"
   asp-action="Index"
   class="btn btn-secondary">
    Back to Events
</a>